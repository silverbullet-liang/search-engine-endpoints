          "params": { "tn": "resultjson_com", "word": "必填", "pn": "偏移", "rn": "30", "gsm": "= hex(pn)，30→1e、60→3c" }
        },
        {
          "id": "baidu.web",
          "purpose": "网页搜索",
          "available": false,
