      "name": "秘塔 AI 搜索",
      "docs": "metaso/",
      "endpoints": [
        {
          "id": "metaso.search",
          "purpose": "AI 搜索",
          "available": false,
          "reason": "需要 API Key：POST 返回 200 + {\"errCode\":2005,\"errMsg\":\"API密钥无效\"}；GET 返回 405",
