  ],
  "recipes": [
    {
      "goal": "按关键词取 100 张图片（含来源页与原图）",
      "steps": ["bing.images.async: first=1,36,71（每次 35 条）", "按 md5 去重", "取 turl 做缩略图、purl 做来源"]
    },
    {
      "goal": "按关键词取视频列表（含播放量/时长）",
      "steps": ["先取 buvid3", "bilibili.search.video: page_size=50, page=1..N", "过滤 type=='video'", "标题去 <em>，pic 补 https:"]
    },
    {
      "goal": "拿当日各平台热榜",
      "steps": ["douyin.hot（49 条，带热度值）", "bilibili.hotword（10 条）"]
    },
    {
      "goal": "输入框联想",
      "steps": ["中文通用：baidu.suggest 或 360.suggest", "视频场景：bilibili.suggest（带高亮区间）", "短视频场景：douyin.suggest（带 pos 区间）"]
    }
  ]
}
